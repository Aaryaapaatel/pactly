# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role / secret key. Used ONLY by POST /api/ingest (src/lib/supabase/admin.ts)
# to write on behalf of a user resolved from an API key - every other route in
# the app uses the anon key + the signed-in user's session instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: your production URL, used for the sitemap, robots.txt, and social
# preview image. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Stripe (dashboard.stripe.com). STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET
# are server-only - never used in client code. STRIPE_PRO_PRICE_ID is the
# Price ID (not Product ID) for the $49/month Pro plan.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Optional: posts a message when a policy violation is found. Leave unset to
# disable Slack alerts entirely.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Required for the two cron endpoints (transcript auto-purge, bulk-ingest
# queue processor) to accept requests. Vercel automatically sends this as
# a Bearer token to your cron routes when CRON_SECRET is set - generate any
# long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Documented for DPA/compliance purposes - see src/lib/anthropic.ts for what
# this does and does not actually control.
TRAINING_ENABLED=false
