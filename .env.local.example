# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role / secret key. Used ONLY by POST /api/ingest (src/lib/supabase/admin.ts)
# to write on behalf of a user resolved from an API key - every other route in
# the app uses the anon key + the signed-in user's session instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
